# Copiar a .env. Entorno > archivo; argumentos CLI > ambos.
# 1 = simulador, 0 = hardware. La adquisición Docker de ejemplo fuerza simulador.
SMP_SIMULATE=1
SMP_DB_PATH=data/acquisition.sqlite3
SMP_OUT_DIR=data
SMP_LABEL=laboratorio
SMP_SERIAL_PORT=auto
SMP_BAUD=19200
SMP_PARITY=E
SMP_TIMEOUT_S=0.3
SMP_ADDRESSES="2 3 4"
SMP_PYRGEOMETERS="2"
SMP_INTERVAL_S=1
# Base del observatorio (configuración y bitácora) y archivo Parquet.
# Por defecto, junto a SMP_DB_PATH.
SMP_OBSERVATORY_DB=data/observatory.sqlite3
SMP_ARCHIVE_DIR=data/archive
# Días de muestras de 1 s en la base activa; 0 = no podar. Los minutos se conservan siempre.
SMP_RETENTION_DAYS=30
# Comprobación del reloj por SNTP; vacío = deshabilitada. No ajusta el reloj.
SMP_NTP_SERVER=pool.ntp.org
SMP_CLOCK_CHECK_S=600
SMP_CLOCK_MAX_OFFSET_S=1
# Simulador: sitio (por defecto el de referencia NREL SPA), bola de sombra y seguidor.
# SMP_SIM_LAT=39.742476
# SMP_SIM_LON=-105.1786
# SMP_SIM_ALT=1830
SMP_SIM_SHADED=
SMP_SIM_TRACKER=1
# La web escucha solo en localhost: no hay autenticación.
SMP_API_HOST=127.0.0.1
SMP_API_PORT=8050
SMP_POLL_S=1
SMP_STALE_S=5
SMP_FRONTEND_DIR=frontend/build
# Terminal legible (texto) o trazas JSON en la terminal (json, formato anterior).
SMP_LOG_FORMAT=texto
# Nivel del archivo de trazas data/logs/<comando>.jsonl: WARNING guarda solo fallos;
# INFO guarda cada operación (más disco y CPU). Rota a 5 MB × 5 archivos.
SMP_LOG_LEVEL=WARNING
# SMP_LOG_DIR=data/logs
# Adquisición: 0 = una línea por ciclo; N = una línea de promedios cada N s.
SMP_CONSOLE_SUMMARY_S=0
# Solo Docker: carpeta local absoluta para web con adquisición nativa.
# En Windows: C:/ruta/al/proyecto/data. No usar carpeta de red o OneDrive.
SMP_DATA_DIR=./data
# Linux: deben coincidir con id -u e id -g del propietario de data.
SMP_UID=1000
SMP_GID=1000
# Solo compose.hardware.yml en Linux.
SMP_DEVICE=/dev/ttyUSB0
