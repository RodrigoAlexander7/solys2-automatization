# Copiar a .env. Entorno > archivo; argumentos CLI > ambos.
# 1 = simulador, 0 = hardware. La adquisición Docker de ejemplo fuerza simulador.
SMP_SIMULATE=1
SMP_DB_PATH=data/acquisition.sqlite3
SMP_OUT_DIR=data
SMP_LABEL=laboratorio
SMP_SERIAL_PORT=auto
SMP_BAUD=19200
SMP_PARITY=E
SMP_TIMEOUT_S=0.3
SMP_ADDRESSES="2 3 4"
SMP_PYRGEOMETERS="2"
SMP_INTERVAL_S=1
SMP_API_HOST=127.0.0.1
SMP_API_PORT=8050
SMP_POLL_S=1
SMP_STALE_S=5
SMP_FRONTEND_DIR=frontend/build
SMP_LOG_LEVEL=INFO
# Solo Docker: carpeta local absoluta para web con adquisición nativa.
# En Windows: C:/ruta/al/proyecto/data. No usar carpeta de red o OneDrive.
SMP_DATA_DIR=./data
# Linux: deben coincidir con id -u e id -g del propietario de data.
SMP_UID=1000
SMP_GID=1000
# Solo compose.hardware.yml en Linux.
SMP_DEVICE=/dev/ttyUSB0
